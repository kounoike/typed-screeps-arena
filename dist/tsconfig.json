{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["esnext"],
        "target": "es2017",
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": "./",
        "paths": {
            "game": ["game/index.d.ts"],
            "game/*": ["game/*"],
            "arena": ["arena/index.d.ts"],
            "arena/*": ["arena/*"]
        }
    },
    "include": ["./index.d.ts", "./game/**/*.d.ts", "./arena/**/*.d.ts", "./**/*.test-d.ts"],
    "exclude": ["node_modules"]
}
