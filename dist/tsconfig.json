{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["esnext"],
        "target": "es2017",
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "noEmit": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["./**/*.d.ts", "./test/**/*.ts"],
    "exclude": ["node_modules"]
}
