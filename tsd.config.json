{
    "directory": "dist",
    "compilerOptions": {
        "types": [],
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "ES2017",
        "strict": true,
        "baseUrl": "./",
        "paths": {
            "game": [
                "game/index.d.ts"
            ],
            "game/*": [
                "game/*"
            ],
            "arena": [
                "arena/index.d.ts"
            ],
            "arena/*": [
                "arena/*"
            ]
        }
    }
}
